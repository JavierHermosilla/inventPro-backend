# Backend production environment
# Copy to your prod host and fill the real values.

NODE_ENV=production
PORT=3000

# Database (PostgreSQL)
DB_HOST=your-db-host
DB_PORT=5432
DB_NAME=inventpro
DB_USER=inventpro_user
DB_PASS=super-strong-password
DB_SCHEMA=inventpro_user

# Auth
JWT_SECRET=generate_a_long_random_secret
ALLOW_COOKIE_AUTH=false

# CORS (comma-separated, no trailing slash)
CORS_ORIGINS=https://app.midominio.com

# Swagger & Metrics basic auth
SWAGGER_USER=infra
SWAGGER_PASS=change_me
METRICS_USER=infra
METRICS_PASS=change_me

# Rate limit
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=500

# Logging
LOG_LEVEL=info

# Misc
CSV_MAX_ROWS=5000
ALLOW_NEGATIVE_STOCK=false
