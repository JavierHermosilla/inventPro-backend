{
  "cli": {
    "version": ">= 13.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "developmentClient": false,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": true
      },
      "env": {
        "EXPO_PUBLIC_USE_API_MOCKS": "false",
        "EAS_PROJECT_ROOT": "fase_2/proyectos/MobileManualInventory"
      }
    },
    "production": {
      "developmentClient": false,
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_USE_API_MOCKS": "false",
        "EAS_PROJECT_ROOT": "fase_2/proyectos/MobileManualInventory"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
