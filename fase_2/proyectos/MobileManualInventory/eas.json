{
  "cli": {
    "version": ">= 13.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "developmentClient": false,
      "distribution": "internal",
      "credentialsSource": "local",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": true
      },
      "env": {
        "EXPO_PUBLIC_USE_API_MOCKS": "false",
        "EXPO_PUBLIC_API_URL": "https://inventpro-backend-production.up.railway.app/api"
      }
    },
    "production": {
      "developmentClient": false,
      "autoIncrement": true,
      "credentialsSource": "local",
      "env": {
        "EXPO_PUBLIC_USE_API_MOCKS": "false",
        "EXPO_PUBLIC_API_URL": "https://inventpro-backend-production.up.railway.app/api"
      },
      "channel": "production"
    }
  },
  "submit": {
    "production": {}
  }
}
